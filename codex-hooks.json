{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "path-to-post-agent-status codex" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "path-to-post-agent-status codex" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "path-to-post-agent-status codex" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "path-to-post-agent-status codex" }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          { "type": "command", "command": "path-to-post-agent-status codex" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "path-to-post-agent-status codex" }
        ]
      }
    ]
  }
}
